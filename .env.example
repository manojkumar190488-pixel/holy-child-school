# ============================================================
# OpportunityIQ - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Full async SQLAlchemy connection string for the application
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/opportunityiq

# Individual Postgres vars used by the postgres Docker container
POSTGRES_DB=opportunityiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ============================================================
# REDIS CONFIGURATION
# ============================================================

# Redis connection string for Celery broker and caching
REDIS_URL=redis://redis:6379/0

# ============================================================
# AI API KEYS
# ============================================================

# OpenAI API key - used for GPT-4 job analysis, embeddings (text-embedding-3-small)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API key - used for Claude job scoring and analysis
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# GOOGLE OAUTH 2.0
# ============================================================

# Google OAuth credentials for "Sign in with Google"
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# ============================================================
# JWT AUTHENTICATION
# ============================================================

# Secret key for signing JWT tokens - use a long random string
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=your_very_long_random_secret_key_here_minimum_64_characters

# Algorithm used for JWT signing (RS256 for production with public/private keys)
JWT_ALGORITHM=HS256

# Token expiry in minutes (1440 = 24 hours, 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# EMAIL NOTIFICATIONS (SMTP)
# ============================================================

# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS/STARTTLS, 465 for SSL, 25 for plain)
SMTP_PORT=587

# SMTP authentication username (usually your email address)
SMTP_USER=your_email@gmail.com

# For Gmail: use an App Password, not your account password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_char_app_password

# The "From" address shown in sent emails
FROM_EMAIL=noreply@opportunityiq.ai

# Primary recipient for daily job digests
DIGEST_RECIPIENT_EMAIL=user@example.com

# ============================================================
# TELEGRAM NOTIFICATIONS
# ============================================================

# Telegram bot token from @BotFather
# Create a bot: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram chat ID for receiving notifications
# Get it from: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Human-readable application name (used in emails, UI)
APP_NAME=OpportunityIQ

# Deployment environment: development | staging | production
ENVIRONMENT=production

# Enable debug mode (detailed error messages, auto-reload)
# NEVER set to true in production
DEBUG=false

# Frontend application URL (used for CORS, email links)
FRONTEND_URL=http://localhost:3000

# Backend API URL (used by frontend to reach the API)
BACKEND_URL=http://localhost:8000

# Allowed CORS origins as a JSON array
# In production: ["https://yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Secret key for encrypting session data
SESSION_SECRET=another_long_random_secret_for_sessions

# ============================================================
# SCHEDULER CONFIGURATION
# ============================================================

# Hour (0-23) at which the daily scraping job runs
DAILY_SCRAPE_HOUR=8

# Minute (0-59) at which the daily scraping job runs
DAILY_SCRAPE_MINUTE=0

# Timezone for scheduling (IANA timezone database name)
# Common values: UTC, US/Eastern, US/Pacific, Europe/London, Asia/Kolkata
TIMEZONE=Asia/Kolkata

# ============================================================
# RATE LIMITING & SCRAPER CONFIG
# ============================================================

# Seconds to wait between HTTP requests during scraping
# Increase if you get rate-limited (recommended: 2-5)
SCRAPER_REQUEST_DELAY=2

# Maximum number of retries for failed HTTP requests
MAX_RETRIES=3

# Concurrency limit for parallel scraping tasks
SCRAPER_CONCURRENCY=5

# Maximum jobs to process per scraping run per source
MAX_JOBS_PER_SOURCE=100

# ============================================================
# VECTOR SEARCH (pgvector)
# ============================================================

# Dimensionality of embeddings (must match the model used)
# text-embedding-3-small = 1536, text-embedding-3-large = 3072
EMBEDDING_DIMENSION=1536

# Number of nearest neighbours to fetch for semantic search
VECTOR_SEARCH_LIMIT=20

# ============================================================
# LOGGING
# ============================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log output format: json | text
LOG_FORMAT=json
