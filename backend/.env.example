# ============================================
# GovIntel AI — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# App
APP_NAME="GovIntel AI"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobagent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# OpenAI (for embeddings + GPT-4 scoring)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_DIMENSIONS=1536

# Anthropic Claude (fallback AI)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@govintel.ai
EMAIL_FROM_NAME="GovIntel AI"

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-default-chat-id

# WhatsApp (optional, Twilio WhatsApp Business API or compatible)
WHATSAPP_API_TOKEN=your-account-sid:your-auth-token
WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/YOUR_SID/Messages.json
WHATSAPP_FROM_NUMBER=+14155238886
WHATSAPP_TO_NUMBER=+91XXXXXXXXXX

# Alert rules — notify only when one of these is exceeded
ALERT_MIN_MATCH_SCORE=80.0
ALERT_MIN_VALUE_INR=2500000
ALERT_ON_LEADERSHIP_MATCH=true

# Opportunity qualification thresholds
FULL_TIME_MIN_EXPERIENCE_YEARS=12
FULL_TIME_PREFERRED_EXPERIENCE_YEARS=15
FREELANCE_MIN_VALUE_INR=100000
FREELANCE_MIN_HOURLY_RATE_INR=5000
STRICT_NCR_FILTER_FULL_TIME=true

# Consulting marketplace partner API keys (optional — inactive until set)
CATALANT_API_KEY=
COMATCH_API_KEY=
TALMIX_API_KEY=
EXPERT360_API_KEY=
MALT_API_KEY=
BTG_API_KEY=

# Expert network partner API keys (optional — inactive until set)
GLG_API_KEY=
GUIDEPOINT_API_KEY=
ALPHASIGHTS_API_KEY=
THIRDBRIDGE_API_KEY=
COLEMAN_API_KEY=

# Government procurement (optional — GeM requires a registered seller API credential)
GEM_API_KEY=

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Scraping
SCRAPING_ENABLED=true
SCRAPING_RATE_LIMIT_DELAY=2.0
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT=30
USER_AGENT_ROTATION=true

# Scheduler (IST) — discovery agent runs 3x/day; digest compiled once after the morning run
SCHEDULER_TIMEZONE=Asia/Kolkata
DISCOVERY_RUN_HOURS=[6,12,18]
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0
REFRESH_JOBS_INTERVAL_HOURS=6

# Features
AI_SCORING_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
TELEGRAM_NOTIFICATIONS_ENABLED=false
VECTOR_SEARCH_ENABLED=true

# Frontend URL (for links in emails)
FRONTEND_URL=http://localhost:3000
