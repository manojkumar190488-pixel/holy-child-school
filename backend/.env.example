# ============================================
# Job Intelligence Agent — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# App
APP_NAME="Job Intelligence Agent"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobagent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# OpenAI (for embeddings + GPT-4 scoring)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_DIMENSIONS=1536

# Anthropic Claude (fallback AI)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@jobintelligence.ai
EMAIL_FROM_NAME="Job Intelligence Agent"

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-default-chat-id

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Scraping
SCRAPING_ENABLED=true
SCRAPING_RATE_LIMIT_DELAY=2.0
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT=30
USER_AGENT_ROTATION=true

# Scheduler (IST)
SCHEDULER_TIMEZONE=Asia/Kolkata
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0
REFRESH_JOBS_INTERVAL_HOURS=6

# Features
AI_SCORING_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
TELEGRAM_NOTIFICATIONS_ENABLED=false
VECTOR_SEARCH_ENABLED=true

# Frontend URL (for links in emails)
FRONTEND_URL=http://localhost:3000
